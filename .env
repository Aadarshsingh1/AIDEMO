# TreosAutomation — Environment Variables
# Vite reads THIS file (.env), not .env.example
# ⚡ To switch n8n accounts or Google Sheets, ONLY edit this file — no code changes needed!

# ── N8n Cloud Instance ────────────────────────────────────────────────────────
# Your N8n Cloud base URL (no trailing slash)
# Change this when switching to a different n8n account
VITE_N8N_BASE_URL=https://aadarshh.app.n8n.cloud

# ── Webhook IDs ───────────────────────────────────────────────────────────────
# Copy the Webhook ID from your n8n workflow's Webhook / Form Trigger node
# (The part after /webhook/ or /form/ in the trigger URL)
# These will be DIFFERENT for every n8n account — update when switching accounts

# Google Maps Lead Scraper workflow webhook ID
VITE_WEBHOOK_GOOGLE_MAPS=a4651de5-023b-46b6-876c-d69102ea548a

# Cordiso / Google Lead Scraper workflow webhook ID
VITE_WEBHOOK_CORDISO_LEADS=c72fef20-8eb0-4815-a3d5-e627e70d77a3

# ── Google Sheets — Edit URLs (for "Open in Sheets" button) ──────────────────
# These are the regular edit links shown in your browser address bar

# Google Maps Lead Scraper sheet edit URL
VITE_MAPS_SHEET_EDIT_URL=https://docs.google.com/spreadsheets/d/1uN4Jl2-2kc3ACuV6wv1XA-2WOCS3r00hcHe08R7kxfY/edit

# Cordiso AI Leads sheet edit URL
VITE_CORDISO_SHEET_EDIT_URL=https://docs.google.com/spreadsheets/d/1M03thDQr0sPIf4oZMitm8_MD9wvC9dA3GVxc5k8qTjk/edit

# ── Google Sheets — Published CSV URLs (for reading data in the app) ──────────
# ⚠ These must be PUBLISHED CSV URLs, NOT the regular edit links.
#
# To get the correct CSV URL:
# 1. Open your Google Sheet
# 2. File → Share → Publish to web
# 3. Select "Sheet1" from the first dropdown
# 4. Select "Comma-separated values (.csv)" from the second dropdown
# 5. Click "Publish" → Copy the URL shown
#
# Correct format: https://docs.google.com/spreadsheets/d/e/LONG_ID/pub?gid=0&single=true&output=csv

# Google Maps Lead Scraper sheet CSV URL
VITE_MAPS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQd0uz4SeghsGbN7v2p9ZHQ02LEkWFUZmap4aCY9NUj9C4H2xSC3JUes_w9Bn5v9lQnV5gUFyh7M6Fx/pub?gid=0&single=true&output=csv

# Cordiso AI Leads sheet CSV URL
VITE_CORDISO_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQYQhotqbxf784TuGcimQOSkUA8xp4qry_tobwiatqIY2D1DPT7_xTStM0IHofj97eUeG3BL6j34Ccv/pub?gid=0&single=true&output=csv

# ── RAG Knowledge Base ────────────────────────────────────────────────────────
VITE_WEBHOOK_RAG_UPLOAD=b7430c49-07df-4ea8-971c-4340d99bc456
VITE_WEBHOOK_RAG_CHAT=911eeda3-33e7-42b7-8054-4cffc04f36a4

# ── No Action Plan Leads ──────────────────────────────────────────────────────
VITE_WEBHOOK_NO_ACTION_PLAN=71a1b559-084e-46a1-94cb-6f158d17d2cc
VITE_NO_ACTION_ALL_LEADS_SHEET_URL=https://docs.google.com/spreadsheets/d/1zO7j2VMY0uwnNCEl__Ugf3xdg26locz2qgc9pmCrEPM/edit?gid=1959112082#gid=1959112082
VITE_NO_ACTION_ALL_LEADS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vT8QuJUoBvfGTzDnG-tylVs0403vtFKv_9APjTwWpAzzqTszjuyJ4JbR71Zg5KiwcRKCxcdk1m1haOZ/pub?gid=1959112082&single=true&output=csv
