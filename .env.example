# ─── TreosAutomation Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# After changing .env, restart the dev server: npm run dev
#
# ⚡ This is the ONLY file you need to change when switching n8n accounts
#    or Google Sheets. No code changes required anywhere else.
# ──────────────────────────────────────────────────────────────────────────────

# ── N8n Cloud Instance ────────────────────────────────────────────────────────
# Your N8n Cloud base URL — no trailing slash
# Find this in your n8n account: it's the URL in your browser when logged in
# Example: https://yourname.app.n8n.cloud
VITE_N8N_BASE_URL=https://YOUR_ACCOUNT.app.n8n.cloud

# ── Webhook IDs ───────────────────────────────────────────────────────────────
# How to find your Webhook ID:
#   1. Open your n8n workflow
#   2. Click the Webhook node or Form Trigger node
#   3. Copy the ID shown in the webhook URL
#      e.g. https://yourname.app.n8n.cloud/webhook/THIS-IS-THE-ID
# ⚠ These IDs are unique per n8n account — update both when switching accounts

# Google Maps Lead Scraper workflow webhook ID
VITE_WEBHOOK_GOOGLE_MAPS=PASTE_YOUR_WEBHOOK_ID_HERE

# Cordiso / Google Lead Scraper workflow webhook ID
VITE_WEBHOOK_CORDISO_LEADS=PASTE_YOUR_WEBHOOK_ID_HERE

# ── Google Sheets — Edit URLs (used for "Open Sheet" buttons) ─────────────────
# These are the regular URLs you see in your browser when viewing the sheet
# Example: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# Google Maps Lead Scraper results sheet
VITE_MAPS_SHEET_EDIT_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# Cordiso AI Leads results sheet
VITE_CORDISO_SHEET_EDIT_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# ── Google Sheets — Published CSV URLs (used to read data into the table) ────
# ⚠ These MUST be Published CSV URLs — the regular edit link will NOT work!
#
# How to get the Published CSV URL:
#   1. Open your Google Sheet
#   2. File → Share → Publish to web
#   3. First dropdown: select "Sheet1"
#   4. Second dropdown: select "Comma-separated values (.csv)"
#   5. Click "Publish" → copy the URL shown
#
# Correct format:
#   https://docs.google.com/spreadsheets/d/e/LONG_PUBLISHED_ID/pub?gid=0&single=true&output=csv

# Google Maps Lead Scraper published CSV URL
VITE_MAPS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub?gid=0&single=true&output=csv

# Cordiso AI Leads published CSV URL
VITE_CORDISO_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub?gid=0&single=true&output=csv
